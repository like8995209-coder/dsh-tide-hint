{
  "name": "dsh-tide-hint",
  "version": "1.2.1",
  "private": true,
  "description": "DSH 侧边栏峰谷时段提示：北京时间、法定节假日、调休、每日官方规则更新与官方充值优惠只读采集。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2"
  },
  "license": "MIT"
}
